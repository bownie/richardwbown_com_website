{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "richardwbown",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./dist",
    // Astro builds with trailingSlash: "always", so force that form here too
    // rather than relying on the "auto" default to guess it.
    "html_handling": "force-trailing-slash",
    // Serve the Astro-generated dist/404.html with a real 404 status.
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  // A Worker Route rather than a custom domain. A custom domain requires the
  // existing A records at the apex to be deleted first (error 100117), which is
  // a DNS change; a route intercepts requests to the already-proxied hostname
  // instead, so no DNS record is touched. The old A records stay in place as the
  // rollback path: remove this route and the site falls back to WordPress.
  //
  // MX (Google Workspace), the SPF/DMARC TXT records and every other subdomain
  // are untouched either way, so mail keeps working across the cutover.
  "routes": [
    { "pattern": "richardwbown.com/*", "zone_name": "richardwbown.com" }
  ]
}
