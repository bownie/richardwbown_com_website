---
import frauncesFont from "../assets/fonts/Fraunces-Variable.woff2?url";
import interFont from "../assets/fonts/Inter-Variable.woff2?url";
import "../styles/global.css";
import { googleAnalyticsId } from "../data/analytics";
import { showTalks, talks } from "../data/talks";
import { sitePath } from "../utils/site-url";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  image?: string;
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description,
  canonicalPath,
  ogType = "website",
  publishedTime,
  image,
  structuredData
} = Astro.props;
const site = Astro.site ?? new URL("https://richardwbown.com");
const isPreview = site.hostname !== "richardwbown.com";
const canonical = new URL(sitePath(canonicalPath), site);
const socialImage = image ? new URL(sitePath(image), site).href : undefined;
const gaId = isPreview ? undefined : googleAnalyticsId;
const showTalksNavigation = showTalks && talks.length >= 3;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      href={frauncesFont}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href={interFont}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link rel="icon" type="image/svg+xml" href={sitePath("favicon.svg")} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {isPreview && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && (
      <>
        <meta property="og:image" content={socialImage} />
        <meta property="og:image:alt" content={title} />
      </>
    )}
    <meta
      name="twitter:card"
      content={socialImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {ogType === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {structuredData && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(structuredData)}
      />
    )}
    {gaId && (
      <>
        <script
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}
        ></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            window.dataLayer.push(arguments);
          }
          gtag("js", new Date());
          gtag("config", gaId);
        </script>
      </>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="site-name" href={sitePath("")}>Richard W. Bown</a>
        <nav class="desktop-nav" aria-label="Main navigation">
          <a href={sitePath("#perspective")}>Perspective</a>
          <a href={sitePath("#writing")}>Writing</a>
          <a href={sitePath("#ideas")}>Ideas</a>
          {showTalksNavigation && <a href={sitePath("#talks")}>Talks</a>}
          <a href={sitePath("#about")}>About</a>
          <a href={sitePath("work-with-me/")}>Work with me</a>
          <a href={sitePath("#contact")}>Contact</a>
        </nav>
        <details class="mobile-menu">
          <summary>Menu</summary>
          <nav class="mobile-nav-links" aria-label="Mobile navigation">
            <a href={sitePath("#perspective")}>Perspective</a>
            <a href={sitePath("#writing")}>Writing</a>
            <a href={sitePath("#ideas")}>Ideas</a>
            {showTalksNavigation && <a href={sitePath("#talks")}>Talks</a>}
            <a href={sitePath("#about")}>About</a>
            <a href={sitePath("work-with-me/")}>Work with me</a>
            <a href={sitePath("#contact")}>Contact</a>
          </nav>
        </details>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>Richard W. Bown</p>
    </footer>
    <script>
      type Gtag = (
        command: "event",
        name: string,
        params?: Record<string, unknown>
      ) => void;

      const outboundEvents: Record<string, string> = {
        "www.linkedin.com": "outbound_linkedin",
        "linkedin.com": "outbound_linkedin",
        "bsky.app": "outbound_bluesky"
      };

      // Sends a GA4 event when a reader leaves for LinkedIn or Bluesky, and when
      // they click a CTA marked with data-ga-event. No-ops in preview builds,
      // where gtag is never loaded.
      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const link = target.closest("a");
        if (!(link instanceof HTMLAnchorElement)) return;

        const gtag = (window as unknown as { gtag?: Gtag }).gtag;
        if (typeof gtag !== "function") return;

        const destination = new URL(link.href, window.location.href);
        const outboundEvent = outboundEvents[destination.hostname];
        const isExternal = destination.origin !== window.location.origin;
        const eventName = link.dataset.gaEvent ?? outboundEvent;

        if (!eventName) return;
        if (!link.dataset.gaEvent && !isExternal) return;

        gtag("event", eventName, {
          destination:
            link.dataset.gaDestination ?? outboundEvent ?? destination.hostname,
          link_url: link.href,
          link_text: (link.textContent ?? "").trim().slice(0, 100),
          page_path: window.location.pathname,
          transport_type: "beacon"
        });
      });
    </script>
  </body>
</html>
