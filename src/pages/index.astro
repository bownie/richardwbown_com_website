---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { ideas } from "../data/ideas";
import { socialLinks } from "../data/social-links";
import { talks } from "../data/talks";
import { sitePath } from "../utils/site-url";
import { Image } from "astro:assets";
import profilePhoto from "../assets/richard-bown-profile.jpg";

const posts = await getCollection("posts");
const postsBySlug = new Map(
  posts.map((post) => [post.id.replace(/\.mdx?$/, ""), post])
);
const featuredPosts = [
  "residues-time-change-and-uncertainty-in-software-architecture-barry-oreilly",
  "susanne-kaiser-architecture-for-flow",
  "what-you-need-to-know-before-running-a-backstage-proof-of-concept",
  "do-bounded-contexts-and-domain-driven-design-even-matter",
  "legacy-systems-and-the-cost-of-hidden-technical-debt"
]
  .map((slug) => postsBySlug.get(slug))
  .filter((post) => post !== undefined)
  .map((post) => ({
    post,
    readingMinutes: Math.max(
      1,
      Math.ceil((post.body?.trim().split(/\s+/).length ?? 0) / 220)
    )
  }));
const talksSectionVisible = talks.length >= 3;
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Richard W. Bown",
  sameAs: [socialLinks.linkedin, socialLinks.bluesky]
};
---

<BaseLayout
  title="Richard W. Bown — Software Architect"
  description="Writing and appearances on software architecture, platform engineering, and software delivery."
  canonicalPath=""
  structuredData={person}
>
  <div class="home-page">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-content">
        <h1 class="hero-title" id="hero-title">
          Platforms, infrastructure and the people who use them
        </h1>
        <Image
          class="profile-photo"
          src={profilePhoto}
          alt="Richard Bown smiling outdoors in front of a brick wall."
          width={640}
          loading="eager"
          fetchpriority="high"
        />
        <p class="hero-intro">
          Hello, I'm Richard. I'm a hands-on, senior platform architect with
          30 years experience across banking, insurance and complex enterprise
          environments. I work on infrastructure across AWS, GCP, Azure,
          platform-as-a-product, cognitive load and socio-technical architecture,
          and I occasonally write about what works and what doesn't work. I'm also a
          Team Topologies Advocate and contributor to the 2nd edition of the book.
        </p>
        <ul class="hero-links" aria-label="Contact links">
          <li><a href={socialLinks.linkedin}>LinkedIn</a></li>
          <li><a href={socialLinks.bluesky}>Bluesky</a></li>
        </ul>
      </div>
    </section>

    <section
      class="home-section home-section--tinted"
      id="perspective"
      aria-labelledby="perspective-title"
    >
      <header class="section-heading">
        <p class="section-label">Point of view</p>
        <h2 id="perspective-title">Perspective</h2>
      </header>
      <div class="perspective-copy">
        <p>Making platforms the logical choice.</p>
        <p>Picking infrastructure by workload, not ideology</p>
        <p>The hard problems are rarely technical. They’re cognitive load,
          unclear boundaries, and the slow accumulation of decisions nobody
          revisited.</p>
      </div>
    </section>

    <section class="home-section" id="writing" aria-labelledby="writing-title">
      <header class="section-heading">
        <p class="section-label">Writing</p>
        <h2 id="writing-title">Selected writing</h2>
      </header>
      <div class="writing-grid">
        {featuredPosts.map(({ post, readingMinutes }) => (
          <article class="writing-card">
            <p class="card-meta">About {readingMinutes} min read</p>
            <h3>
              <a href={sitePath(`${post.id.replace(/\.mdx?$/, "")}/`)}>
                {post.data.title}
              </a>
            </h3>
            <p>{post.data.summary}</p>
          </article>
        ))}
      </div>
      <a class="all-writing" href={sitePath("writing/")}>All writing →</a>
    </section>

    <section
      class="home-section home-section--tinted"
      id="ideas"
      aria-labelledby="ideas-title"
    >
      <header class="section-heading">
        <p class="section-label">Ideas</p>
        <h2 id="ideas-title">Ideas</h2>
      </header>
      <div class="ideas-grid">
        {ideas.map((idea) => (
          <article class="idea-card">
            <h3>
              {idea.relatedPost ? (
                <a href={sitePath(`${idea.relatedPost}/`)}>{idea.title}</a>
              ) : (
                idea.title
              )}
            </h3>
            <p>{idea.summary}</p>
          </article>
        ))}
      </div>
    </section>

    <section
      class="home-section"
      id="in-practice"
      aria-labelledby="practice-title"
    >
      <header class="section-heading">
        <p class="section-label">Selected work</p>
        <h2 id="practice-title">In practice</h2>
      </header>
      <div class="practice-grid">
        <article class="practice-card">
          <p class="card-meta">Twinfield / Wolters Kluwer · 2019–2021</p>
          <p>
            Led engineering across NL, Kyiv and Pune (~100 developers, ~$5m
            budget); implemented SOC2 controls leading to ISAE3402
            accreditation; started the Kubernetes/microservices modernisation
            of a 20-year-old SaaS platform.
          </p>
        </article>
        <article class="practice-card">
          <p class="card-meta">Ahold Delhaize · 2021–2022</p>
          <p>
            Global product owner for GitHub; defined DevOps and developer-tooling
            standards across operating companies and was central contact for
            the rollout to 2,500+ developers.
          </p>
        </article>
      </div>
    </section>

    {talksSectionVisible && (
      <section
        class="home-section"
        id="talks"
        aria-labelledby="talks-title"
      >
        <header class="section-heading">
          <p class="section-label">Talks &amp; podcasts</p>
          <h2 id="talks-title">Public appearances</h2>
        </header>
        <ul class="talk-list">
          {talks.map((talk) => (
            <li>
              <h3>
                {talk.url && talk.title ? (
                  <a href={talk.url}>{talk.title}</a>
                ) : (
                  talk.show
                )}
              </h3>
              {(talk.date || talk.title) && (
                <p class="talk-meta">
                  {talk.show}
                  {talk.date && ` · ${talk.date}`}
                  {talk.role === "guest" && " · Podcast guest"}
                  {talk.role === "speaker" && " · Speaker"}
                  {talk.role === "host" && " · Podcast host"}
                </p>
              )}
            </li>
          ))}
        </ul>
      </section>
    )}

    <section
      class="home-section home-section--tinted"
      id="about"
      aria-labelledby="about-title"
    >
      <header class="section-heading">
        <p class="section-label">Profile</p>
        <h2 id="about-title">About</h2>
      </header>
      <div class="about-short">
        <p>
          Senior platform architect with 30 years across banking, insurance and
          complex enterprise environments. I work on platform-as-a-product,
          cognitive load and socio-technical architecture, and I write about
          what actually works. Team Topologies Advocate and contributor to the
          2nd edition.
        </p>
        <a href={sitePath("about/")}>Full about page</a>
      </div>
    </section>

    <section
      class="home-section home-section--tinted contact-section"
      id="contact"
      aria-labelledby="contact-title"
    >
      <header class="section-heading">
        <p class="section-label">Contact</p>
        <h2 id="contact-title">Get in touch</h2>
      </header>
      <p class="perspective-copy">If you’re working on platform strategy, developer experience or engineering culture, I’m happy to talk.</p>
      <ul class="contact-links">
        <li><a href={socialLinks.linkedin}>LinkedIn</a></li>
        <li><a href={socialLinks.bluesky}>Bluesky</a></li>
      </ul>
    </section>
  </div>
</BaseLayout>
