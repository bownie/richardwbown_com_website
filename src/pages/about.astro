---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import profilePhoto from "../assets/richard-bown-profile.jpg";

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Richard W. Bown"
};
---

<BaseLayout
  title="About — Richard W. Bown"
  description="About Richard W. Bown."
  canonicalPath="about/"
  structuredData={person}
>
  <div class="reading-layout">
    <h1>About</h1>
    <Image
      class="profile-photo"
      src={profilePhoto}
      alt="Richard Bown smiling outdoors in front of a brick wall."
      width={320}
    />
    <section aria-labelledby="role-title">
      <h2 id="role-title">Role</h2>
      <p>TODO: ABOUT_ROLE</p>
    </section>
    <section aria-labelledby="focus-title">
      <h2 id="focus-title">Focus areas</h2>
      <p>TODO: ABOUT_FOCUS_AREAS</p>
    </section>
    <section aria-labelledby="experience-title">
      <h2 id="experience-title">Experience</h2>
      <p>TODO: ABOUT_EXPERIENCE</p>
    </section>
    <section aria-labelledby="selected-work-title">
      <h2 id="selected-work-title">Selected work</h2>
      <p>
        TODO: ABOUT_SELECTED_WORK
        <a href="https://AUTHOR_SITE_URL">AUTHOR_SITE_URL</a>
      </p>
    </section>
    <section aria-labelledby="contact-title">
      <h2 id="contact-title">Contact</h2>
      <p>TODO: ABOUT_CONTACT</p>
    </section>
  </div>
</BaseLayout>
