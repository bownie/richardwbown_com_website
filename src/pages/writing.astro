---
import { existsSync } from "node:fs";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { sitePath } from "../utils/site-url";

const posts = (await getCollection("posts")).filter(
  (post) => !post.data.unlisted
);
const categories = [
  "Architecture",
  "Platform engineering",
  "Delivery & systems thinking",
  "People & teams"
] as const;
const groupedPosts = categories.map((category) => ({
  category,
  posts: posts
    .filter((post) => post.data.category === category)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
}));
const paperPath = new URL(
  "../../public/downloads/A-Systems-Approach-to-Software-Product-Delivery-v1.1-Richard-Bown.pdf",
  import.meta.url
);
const hasPaper = existsSync(paperPath);
---

<BaseLayout
  title="Writing — Richard W. Bown"
  description="Selected writing on software architecture, platform engineering, and delivery and systems thinking."
  canonicalPath="writing/"
>
  <div class="reading-layout">
    <h1>Writing</h1>
    <p class="lede">A selection of writing on software and the systems around it.</p>
    {groupedPosts.map(({ category, posts: categoryPosts }) => (
      <section aria-labelledby={`category-${category}`}>
        <h2 id={`category-${category}`}>{category}</h2>
        <ul class="post-list">
          {categoryPosts.map((post) => (
            <li>
              <a href={sitePath(`${post.id.replace(/\.mdx?$/, "")}/`)}>
                {post.data.title}
              </a>
              <p class="post-meta">
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString("en-GB", {
                    day: "numeric",
                    month: "long",
                    year: "numeric",
                    timeZone: "UTC"
                  })}
                </time>
              </p>
              <p class="post-summary">{post.data.summary}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
  {hasPaper && (
    <section class="reading-layout" aria-labelledby="papers-title">
      <h2 id="papers-title">Papers</h2>
      <ul class="post-list">
        <li>
          <a
            href={sitePath(
              "downloads/A-Systems-Approach-to-Software-Product-Delivery-v1.1-Richard-Bown.pdf"
            )}
          >
            A Systems Approach to Software Product Delivery (version 1.1)
          </a>
        </li>
      </ul>
    </section>
  )}
</BaseLayout>
