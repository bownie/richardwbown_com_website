---
import BaseLayout from "../layouts/BaseLayout.astro";
import { talks } from "../data/talks";

const roleLabels = {
  guest: "Podcast guest",
  host: "Podcast host",
  speaker: "Speaker"
};
---

<BaseLayout
  title="Talks & Podcasts — Richard W. Bown"
  description="Selected conference talk and podcast appearances by Richard W. Bown."
  canonicalPath="talks/"
>
  <div class="reading-layout">
    <h1>Talks &amp; Podcasts</h1>
    {talks.length > 0 && (
      <section aria-labelledby="appearances-title">
        <h2 id="appearances-title">Public appearances</h2>
        <ul class="talk-list">
          {talks.map((item) => (
            <li>
              <h3><a href={item.url}>{item.title}</a></h3>
              <p>{item.show} · {item.date} · {roleLabels[item.role]}</p>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>
