---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { sitePath } from "../utils/site-url";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.mdx?$/, "") },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const canonicalPath = `${post.id.replace(/\.mdx?$/, "")}/`;
const canonicalUrl = new URL(sitePath(canonicalPath), Astro.site).href;
const modified = post.data.updated ?? post.data.date;
const article = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.summary,
  datePublished: post.data.date.toISOString(),
  dateModified: modified.toISOString(),
  author: {
    "@type": "Person",
    name: "Richard W. Bown"
  },
  mainEntityOfPage: canonicalUrl
};
---

<BaseLayout
  title={`${post.data.title} — Richard W. Bown`}
  description={post.data.summary}
  canonicalPath={canonicalPath}
  ogType="article"
  publishedTime={post.data.date.toISOString()}
  structuredData={article}
>
  <article class="reading-layout">
    <header>
      <h1>{post.data.title}</h1>
      <p class="post-meta">
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString("en-GB", {
            day: "numeric",
            month: "long",
            year: "numeric",
            timeZone: "UTC"
          })}
        </time>
        {post.data.updated && (
          <span>
            Updated{" "}
            <time datetime={post.data.updated.toISOString()}>
              {post.data.updated.toLocaleDateString("en-GB", {
                day: "numeric",
                month: "long",
                year: "numeric",
                timeZone: "UTC"
              })}
            </time>
          </span>
        )}
      </p>
    </header>
    <div class="post-content">
      <Content />
    </div>
    <aside class="post-cta" aria-labelledby="post-cta-title">
      <p class="section-label">Consulting</p>
      <h2 id="post-cta-title">Work with me</h2>
      <p>
        If you're working on platform strategy, developer experience or
        engineering culture, I'm happy to talk.
      </p>
      <p class="post-cta-link">
        <a
          href={sitePath("work-with-me/")}
          data-ga-event="cta_click"
          data-ga-destination="work-with-me"
        >
          How I can help →
        </a>
      </p>
    </aside>
    <p class="muted"><a href={sitePath("writing/")}>Back to Writing</a></p>
  </article>
</BaseLayout>
